@model CakeStudio.ViewModels.CartViewModel

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">My Cart</h2>

    <form id="cartCheckoutForm"
          asp-controller="Cart"
          asp-action="Checkout"
          method="post">
    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-cart fs-1 text-muted"></i>

                <h4 class="mt-3">Your cart is empty</h4>

                <p class="text-muted">
                    Browse our cakes and add your favourites.
                </p>

                <a asp-controller="CustomerCake"
                   asp-action="Index"
                   class="btn order-now-btn">
                    Browse Cakes
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- Cart items -->
            <div class="col-lg-8">
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var item = Model.Items[i];
                    <div class="card border-0 shadow-sm rounded-4 mb-3">
                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <h5 class="fw-bold">
                                        @item.CakeName
                                    </h5>

                                    <p class="text-muted mb-1">
                                        Size: @item.SizeName
                                    </p>

                                    <p class="text-muted mb-1">
                                        Flavour: @item.FlavourName
                                    </p>

                                    <p class="text-muted mb-2">
                                        Tier: @item.TierName
                                    </p>

                                    <span class="cake-price fw-semibold">
                                        RM @item.UnitPrice.ToString("N2")
                                        each
                                    </span>
                                </div>

                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@item.CartItemId" />

                                    <button type="submit"
                                            class="btn btn-delete-icon"
                                            aria-label="Remove @item.CakeName">
                                            <i class="bi bi-trash"
                                           aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="mt-3">
                                <input type="hidden"
                                       name="items[@i].CartItemId"
                                       value="@item.CartItemId"
                                       form="cartCheckoutForm" />

                                <label for="message-@item.CartItemId"
                                       class="form-label">
                                    Message on Cake (optional)
                                </label>

                                <textarea id="message-@item.CartItemId"
                                  name="items[@i].MessageOnCakes"
                                  form="cartCheckoutForm"
                                  class="form-control"
                                  rows="2"
                                  maxlength="500"
                                  placeholder="e.g. Happy Birthday!">@item.MessageOnCakes</textarea>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                                <div class="d-flex align-items-center gap-2">
                                    <label for="quantity-@item.CartItemId"
                                           class="mb-0">
                                        Quantity
                                    </label>

                                    <input type="number"
                                           id="quantity-@item.CartItemId"
                                           name="items[@i].Quantity"
                                           value="@item.Quantity"
                                           form="cartCheckoutForm"
                                           min="1"
                                           max="20"
                                           step="1"
                                           required
                                           class="form-control"
                                           style="width: 85px;"
                                           data-cart-quantity
                                           data-unit-price="@item.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           data-subtotal-id="subtotal-@item.CartItemId" />
                                </div>

                                <strong class="cake-price" id="subtotal-@item.CartItemId">
                                    RM @item.Subtotal.ToString("N2")
                                </strong>
                            </div>

                        </div>
                    </div>
                }

             
            </div>

            <!-- Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">

                        <h5 class="fw-bold">Cart Summary</h5>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <span>Total quantity</span>
                            <strong id="cartTotalQuantity">@Model.TotalQuantity</strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <strong>Total Price</strong>

                            <strong class="cake-price" id="cartTotalPrice">
                                RM @Model.TotalPrice.ToString("N2")
                            </strong>
                        </div>

                        <p class="text-muted small mt-3 mb-0">
                            Prices and availability will be checked again at checkout.
                        </p>

                        <button type="submit"
                                form="cartCheckoutForm"
                                class="btn order-now-btn w-100 mt-4">
                            Proceed to Checkout
                        </button>

                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    <script>
        const quantityInputs =
            document.querySelectorAll("[data-cart-quantity]");

        const moneyFormatter = new Intl.NumberFormat("en-MY", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        function updateCartTotals() {
            let totalQuantity = 0;
            let totalPrice = 0;

            quantityInputs.forEach(input => {
                const subtotalElement =
                    document.getElementById(input.dataset.subtotalId);

                if (!input.checkValidity()) {
                    subtotalElement.textContent = "—";
                    return;
                }

                const quantity = Number(input.value);
                const unitPrice = Number(input.dataset.unitPrice);
                const subtotal = quantity * unitPrice;

                totalQuantity += quantity;
                totalPrice += subtotal;

                subtotalElement.textContent =
                    "RM " + moneyFormatter.format(subtotal);
            });

            const allValid = Array.from(quantityInputs)
                .every(input => input.checkValidity());

            document.getElementById("cartTotalQuantity").textContent =
                allValid ? totalQuantity : "—";

            document.getElementById("cartTotalPrice").textContent =
                allValid ? "RM " + moneyFormatter.format(totalPrice) : "—";
        }

        quantityInputs.forEach(input => {
            input.addEventListener("input", updateCartTotals);
        });
    </script>
}