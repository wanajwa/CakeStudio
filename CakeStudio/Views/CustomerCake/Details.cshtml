@model CakeStudio.ViewModels.CustomerCakeDetailsViewModel

@{
    ViewData["Title"] = "Cake Details";
}

<div class="container py-4">

    <!-- Back button -->
    <div class="mb-4">
        <a asp-controller="CustomerCake"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Cakes
        </a>
    </div>

    <div class="row g-4">

        <!-- Left: Cake Image -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm">

                @if (Model.Cake.Image != null)
                {
                    <img src="@Url.Action("Image", "CustomerCake", new { id = Model.Cake.CakeId })"
                         class="img-fluid rounded"
                         alt="@Model.Cake.CakeName"
                         style="width: 100%; height: 400px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light d-flex align-items-center justify-content-center"
                         style="height: 400px;">
                        <span class="text-muted">No Image Available</span>
                    </div>
                }

            </div>
        </div>

        <!-- Right: Cake Details and Options -->
        <div class="col-md-6">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-3">
                        @Model.Cake.CakeName
                    </h2>

                    <span class="badge bg-success mb-3">
                        Available
                    </span>

                    <p class="text-muted">
                        @Model.Cake.Description
                    </p>

                    <hr />

                    <p class="text-muted mb-1">Base Price</p>

                    <h4 class="text-primary fw-bold mb-4">
                        RM @Model.Cake.BasePrice.ToString("0.00")
                    </h4>

                    <!-- Cake Size -->
                    <!-- Standard 6-inch size is included in the base price -->
                    <div class="mb-3">
                        <label for="cakeSize" class="form-label fw-semibold">
                            Cake Size
                        </label>

                        <select id="cakeSize"
                                name="sizeId"
                                class="form-select cake-option">

                            @foreach (var size in Model.CakeSizes
                                                        .OrderBy(s => int.Parse(s.SizeName.Split(' ')[0])))
                            {
                                if (size.IsAvailable)
                                {
                                    bool isDefault = size.SizeName.Trim()
                                    .Equals("6 inch", StringComparison.OrdinalIgnoreCase);

                                    <option value="@size.SizeId"
                                            data-price="@(isDefault ? "0" : size.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                            selected="@isDefault">

                                        @size.SizeName

                                        @if (isDefault)
                                        {
                                            @:(Included)
                                        }
                                        else
                                        {
                                            @:(+RM @size.AdditionalPrice.ToString("0.00"))
                                        }

                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <!-- Cake Flavour -->
                    <!-- Original flavour with optional alternatives -->
                    <div class="mb-3">
                        <label for="cakeFlavour" class="form-label fw-semibold">
                            Cake Flavour
                        </label>

                        <select id="cakeFlavour"
                                name="flavourId"
                                class="form-select cake-option">

                            <!-- Original flavour is included in the base price -->
                            <option value="@Model.Cake.Flavour.FlavourId"
                                    data-price="0"
                                    selected>
                                Original flavour — @Model.Cake.Flavour.FlavourName
                                (Included)
                            </option>

                            @foreach (var flavour in Model.CakeFlavours
                                                        .Where(f => f.IsAvailable &&
                                                        f.FlavourId != Model.Cake.Flavour.FlavourId)
                                                        .OrderBy(f => f.FlavourName))
                            {
                                // Skip the original flavour so it is not shown twice.
                                if (flavour.IsAvailable &&
                                flavour.FlavourId != Model.Cake.Flavour.FlavourId)
                                {
                                    <option value="@flavour.FlavourId"
                                            data-price="@flavour.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @flavour.FlavourName
                                        (+RM @flavour.AdditionalPrice.ToString("0.00"))
                                    </option>
                                }
                            }
                        </select>

                    </div>

                    <!-- Cake Tier -->
                    <div class="mb-3">
                        <label for="cakeTier" class="form-label fw-semibold">
                            Cake Tier
                        </label>

                        <select id="cakeTier" class="form-select cake-option">
                            <option value="" selected disabled>
                                Select Cake Tier
                            </option>

                            @foreach (var tier in Model.CakeTiers)
                            {
                                <option value="@tier.TierId"
                                        data-price="@tier.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    @tier.TierName
                                    (+RM @tier.AdditionalPrice.ToString("0.00"))
                                </option>
                            }
                        </select>
                    </div>

                    <hr />

                    <!-- Total Price -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Total Price</h5>

                        <h4 class="text-primary fw-bold mb-0"
                            id="totalPrice">
                            RM @Model.Cake.BasePrice.ToString("0.00")
                        </h4>
                    </div>

                    <!-- Order button: enabled in a later step -->
                    <button type="button"
                            class="btn btn-primary w-100"
                            disabled>
                        Place Order
                    </button>

                </div>
            </div>
        </div>

    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Base price 
            const basePrice = @Model.Cake.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture);

            // Get cake option dropdowns.
            const sizeSelect = document.getElementById("cakeSize");

            const flavourSelect = document.getElementById("cakeFlavour");

            const tierSelect = document.getElementById("cakeTier");

            // Get total price element.
            const totalPriceElement =
                document.getElementById("totalPrice");

            // Get additional price from selected option.
            function getAdditionalPrice(selectElement) {

                const selectedOption =
                    selectElement.options[selectElement.selectedIndex];

                // Return 0 if no option is selected.
                if (!selectedOption || !selectedOption.value) {
                    return 0;
                }

                // Read the additional price.
                return parseFloat(selectedOption.dataset.price) || 0;
            }

            // Calculate total cake price.
            function calculateTotalPrice() {

                // Get additional charges.
                const sizePrice =
                    getAdditionalPrice(sizeSelect);

                const flavourPrice =
                    getAdditionalPrice(flavourSelect);

                const tierPrice =
                    getAdditionalPrice(tierSelect);

                // Calculate total price.
                const totalPrice =
                    basePrice
                    + sizePrice
                    + flavourPrice
                    + tierPrice;

                // Display updated price.
                totalPriceElement.textContent =
                    "RM " + totalPrice.toFixed(2);
            }

            // Recalculate when customer changes size.
            sizeSelect.addEventListener(
                "change",
                calculateTotalPrice
            );

            // Recalculate when customer changes flavour.
            flavourSelect.addEventListener(
                "change",
                calculateTotalPrice
            );

            // Recalculate when customer changes tier.
            tierSelect.addEventListener(
                "change",
                calculateTotalPrice
            );

            // Calculate initial price when page loads.
            calculateTotalPrice();

        });
    </script>

}
