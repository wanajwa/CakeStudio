@model CakeStudio.ViewModels.CustomerCakeDetailsViewModel

<div class="card shadow-sm border-0">
    <div class="card-body">

        <h4 class="fw-bold">@Model.Cake.CakeName</h4>

        <p class="text-muted">
            @Model.Cake.Description
        </p>

        <h5 class="cake-price mb-4">
            Base Price: RM @Model.Cake.BasePrice.ToString("0.00")
        </h5>

        <!-- Cake Size -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Cake Size</label>

            <select id="cakeSize" name="sizeId" class="form-select cake-option">
                @if(!Model.CakeSizes.Any(s => s.IsAvailable))
                {
                    <option value ="" selected disabled>
                    No cake sizes available    
                    </option>
                }

                @if (Model.CakeSizes.Any(s => s.IsAvailable) &&
                                !Model.CakeSizes.Any(s => s.IsAvailable &&
                                s.SizeName.Trim().Equals("6 inch", StringComparison.OrdinalIgnoreCase)))
                {
                    <option value="" selected disabled>-- Select cake size --</option>
                }

                @foreach (var size in Model.CakeSizes 
                    .Where(s => s.IsAvailable)
                    .OrderBy(s => int.Parse(s.SizeName.Split(' ')[0])))
                {
					bool isDefault = size.SizeName.Trim().Equals("6 inch", StringComparison.OrdinalIgnoreCase);
                    <option value="@size.SizeId"
                    data-price="@(isDefault ? "0" : size.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                       selected="@isDefault">
                       @size.SizeName
                       @if (isDefault)
                       {
                           @:(Included)
						}
                        else
                        {
							@:(+RM @size.AdditionalPrice.ToString("0.00"))
                        }
                        
                    </option>
                }
            </select>
        </div>

        <!-- Cake Flavour -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Cake Flavour</label>

            <select id="cakeFlavour" name="flavourId" class="form-select cake-option">
               
                @if (Model.Cake.Flavour.IsAvailable)
                {
                    <option value="@Model.Cake.Flavour.FlavourId"
                            data-price="0"
                            selected>
                        @Model.Cake.Flavour.FlavourName (Included)
                    </option>
                }
                @if (!Model.Cake.Flavour.IsAvailable &&
                                Model.CakeFlavours.Any(f => f.IsAvailable))
                {
                    <option value="" selected disabled>
                        -- Select cake flavour --
                    </option>
                }

                @if (!Model.Cake.Flavour.IsAvailable &&
                                !Model.CakeFlavours.Any(f => f.IsAvailable &&
                                f.FlavourId != Model.Cake.Flavour.FlavourId))
                {
                    <option value="" selected disabled>
                        No cake flavours available
                    </option>
                }

                @foreach (var flavour in Model.CakeFlavours.
                Where(f => f.IsAvailable && f.FlavourId != Model.Cake.Flavour.FlavourId)
                .OrderBy( f=> f.FlavourName))

                {
                    <option value="@flavour.FlavourId"
                    data-price="@flavour.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        @flavour.FlavourName (+RM @flavour.AdditionalPrice.ToString("0.00"))
                    </option>
                }
            </select>
        </div>

        <!-- Cake Tier -->
        <div class="mb-3">
            <label class="form-label fw-semibold">Cake Tier</label>

            <select id="cakeTier" name="tierId" class="form-select cake-option">
               
                @if (!Model.CakeTiers.Any(t => t.IsAvailable))
                {
                    <option value ="" selected disabled>
                        No cake tiers available
                    </option>
                }

                @if (Model.CakeTiers.Any(t => t.IsAvailable) &&
                                !Model.CakeTiers.Any(t => t.IsAvailable &&
                                t.TierName.Trim().Equals("1", StringComparison.OrdinalIgnoreCase)))
                {
                    <option value="" selected disabled>-- Select cake tier --</option>
                }

                @foreach (var tier in Model.CakeTiers .Where(t => t.IsAvailable)
                .OrderBy(t => t.TierName))
                {
                    bool isDefault = tier.TierName.Trim().Equals("1", StringComparison.OrdinalIgnoreCase);

                    <option value="@tier.TierId"
                    data-price="@(isDefault ? "0" : tier.AdditionalPrice.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                    selected="@isDefault">
                        @tier.TierName Tier
                        @if (isDefault)
                        {
                            @:(Included)
                        }
                        else
                        {
                            @:(+RM @tier.AdditionalPrice.ToString("0.00"))
                                }
                    </option>
                }
            </select>
        </div>

        <hr />

        <!-- Total Price -->
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Total Price</h5>

            <h4 id="totalPrice"
                class="cake-price fw-bold mb-0"
                data-base-price="@Model.Cake.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                RM @Model.Cake.BasePrice.ToString("0.00")
            </h4>
        </div>



        <button type="button"
                class="btn order-now-btn w-100 mt-3"
                onclick="proceedToOrder(@Model.Cake.CakeId)">
            Order Now
        </button>



    </div>
</div>