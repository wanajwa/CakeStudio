@model IEnumerable<CakeStudio.Models.Cake>

@{
    ViewData["Title"] = "Our Cakes";
}

<div class="container py-4">

    <!-- Page heading -->
    <div class="text-center mb-5">
        <h2 class="fw-bold">Our Signature Cakes</h2>
        <p class="text-muted">
            Explore our delicious collection of cakes.
        </p>
    </div>

    <!-- Check whether cakes are available -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No cakes are available at the moment.
        </div>
    }
    else
    {
        <!-- Cake listing -->
        <div class="row g-4">

            @foreach (var cake in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- Cake image -->
                        @if (cake.Image != null)
                        {
                            <img src="@Url.Action("Image", "CustomerCake", new { id = cake.CakeId })"
                                 class="card-img-top"
                                 alt="@cake.CakeName"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">No Image</span>
                            </div>
                        }

                        <!-- Cake information -->
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @cake.CakeName
                            </h5>

                            <p class="card-text text-muted">
                                @cake.Description
                            </p>

                            <h5 class="text-primary mt-auto">
                                RM @cake.BasePrice.ToString("0.00")
                            </h5>

                            <a asp-controller="CustomerCake"
                               asp-action="Details"
                               asp-route-id="@cake.CakeId"
                               class="btn btn-primary mt-3">
                                View Details
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
