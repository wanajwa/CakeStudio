@model IEnumerable<CakeStudio.Models.Cake>

@{
    ViewData["Title"] = "Our Cakes";
}

<div class="container-fluid py-0">

    <!-- Page heading -->
    <div class="cake-page-header">
    <h1>Our Signature Cakes</h1>
    <p>Explore our delicious collection of cakes.</p>
</div>

<div class="px-3 px-lg-5">
    <div id="addToCartFeedback"
         role="status"
         aria-live="polite"
         hidden></div>
</div>

    <!-- Check whether cakes are available -->
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No cakes are available at the moment.
        </div>
    }
    else
    {
        <!-- Main Layout -->
<div class="row g-4 px-3 px-lg-5 pb-5">

    <!-- LEFT: Cake Listing -->
    <div class="col-lg-7">

        <h4 class="fw-semibold mb-3">Browse Cakes</h4>
        <div class="row g-3">

        <!-- Cake Search -->
        <div class="input-group mb-4">
            <span class="input-group-text bg-white">
                <i class="bi bi-search"></i>
            </span>

            <input type="text"
                   id="cakeSearch"
                   class="form-control"
                   placeholder="Search cakes by name..."
                   autocomplete="off"
                   aria-label="Search cakes by name" />
        </div>

        <!-- No search results -->
        <div id="noSearchResults"
             class="alert alert-info text-center d-none">
            No cakes found matching your search.
        </div>

            @foreach (var cake in Model)
            {
                <div class="col-sm-6 col-md-4 cake-item"
                data-cake-name="@cake.CakeName">

                    <div class="card h-100 shadow-sm border-0">

                        <!-- Cake image -->
                        @if (cake.Image != null)
                        {
                            <img src="@Url.Action("Image", "CustomerCake", new { id = cake.CakeId })"
                                 class="card-img-top"
                                 alt="@cake.CakeName"
                                 style="height: 220px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 220px;">
                                <span class="text-muted">No Image</span>
                            </div>
                        }

                        <!-- Cake information -->
                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title fw-bold">
                                @cake.CakeName
                            </h5>

                            <p class="card-text text-muted">
                                @cake.Description
                            </p>

                            <h5 class="cake-price mt-auto">
                                RM @cake.BasePrice.ToString("0.00")
                            </h5>

                                    <button type="button"
                                            class="btn btn-primary mt-3 view-details-btn"
                                            data-cake-id="@cake.CakeId">
                                        View Details
                                    </button>

                                                </div> <!-- End card-body -->

                    </div> <!-- End card -->

                </div> <!-- End cake column -->
            } <!-- End foreach -->

        </div> <!-- End inner cake grid -->

    </div> <!-- End left column -->

    <!-- RIGHT: Cake Details Panel -->
    <div class="col-lg-5" id="cakeDetailsSection">

        <h4 class="fw-semibold mb-3">
            Cake Details
        </h4>

        <div id="cakeDetailsPanel" aria-live="polite">

            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">

                    <h5 class="text-muted">Select a cake</h5>

                    <p class="text-muted mb-0">
                        Click View Details to see cake information
                        and available options.
                    </p>

                                </div> <!-- End card-body -->

            </div> <!-- End card -->

        </div> <!-- End cakeDetailsPanel -->

    </div> <!-- End right column -->
    </div>
}
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const panel = document.getElementById("cakeDetailsPanel");
            if (!panel) return;

            panel.addEventListener("submit", async function (event) {
            const form = event.target;

            if (!form.matches("#addToCartForm")) return;

            event.preventDefault();

            if (form.dataset.submitting === "true") return;
            if (!form.reportValidity()) return;

            const button = form.querySelector('button[type="submit"]');
            const feedback = document.getElementById("addToCartFeedback");
            const originalButton = button.innerHTML;
            const data = new FormData(form);

            form.dataset.submitting = "true";
            button.disabled = true;
            button.textContent = "Adding...";
            feedback.hidden = true;

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: data
                });

                const result = await response.json();

                if (!response.ok) {
                    feedback.className = "alert alert-danger";
                    feedback.textContent =
                        result.message || "Unable to add cake to cart.";
                    feedback.hidden = false;
                    return;
                }

                feedback.className = "alert alert-success";
                feedback.textContent = result.message;
                feedback.hidden = false;

                const cartButton = document.getElementById("floatingCart");
                const badge = document.getElementById("floatingCartCount");

                if (cartButton && badge) {
                    const quantity = result.totalQuantity;

                    badge.textContent = quantity > 99 ? "99+" : quantity;
                    badge.classList.toggle("d-none", quantity === 0);

                    cartButton.setAttribute(
                        "aria-label",
                        "Open cart, " + quantity + " cakes"
                    );
                }
            }
            catch {
                feedback.className = "text-danger mt-3";
                feedback.textContent =
                    "Unable to confirm whether the cake was added. Check your cart before trying again.";
                feedback.hidden = false;
            }
            finally {
                form.dataset.submitting = "false";
                button.disabled = false;
                button.innerHTML = originalButton;
            }
        });

            let currentRequest = null;

            // Cake Search Functionality
            const searchInput = document.getElementById("cakeSearch");
            const cakeItems = document.querySelectorAll(".cake-item");
            const noSearchResults = document.getElementById("noSearchResults");

            if (searchInput && noSearchResults) {

                searchInput.addEventListener("input", function () {

                    const searchText = this.value.trim().toLowerCase();

                    let visibleCount = 0;

                    cakeItems.forEach(cake => 
                    {

                        const cakeName = (cake.dataset.cakeName || "").toLowerCase();

                        const isMatch = cakeName.includes(searchText);

                        cake.classList.toggle("d-none", !isMatch);

                        if (isMatch) {
                            visibleCount++;
                        }
                    });

                    noSearchResults.classList.toggle(
                        "d-none",
                        visibleCount > 0
                    );
                });
            }

            document.querySelectorAll(".view-details-btn")
                .forEach(button => {

                    button.addEventListener("click", async function () {

                        const cakeId = this.dataset.cakeId;

                        if (currentRequest) {
                            currentRequest.abort();
                        }

                        const controller = new AbortController();
                        currentRequest = controller;

                        panel.innerHTML =
                            '<div class="text-center p-4">Loading cake details...</div>';

                        try 
                        {
                            const url = '@Url.Action("DetailsPanel", "CustomerCake")' + '?id=' + encodeURIComponent(cakeId);

                            const response = await fetch(url, 
                            {
                                signal: controller.signal
                            });

                            if (!response.ok) {
                                console.error("HTTP Status:", response.status);
                                console.error("Server response:", await response.text());

                                throw new Error("Unable to load cake details");
                            }

                            panel.innerHTML = await response.text();
                       
                            initializePriceCalculation();

                            // Scroll to Cake Details heading
                            const detailsSection = document.getElementById("cakeDetailsSection");
                            const pageHeader = document.querySelector(".cake-page-header");

                            if (detailsSection) {
                                const headerHeight = pageHeader
                                    ? pageHeader.getBoundingClientRect().height
                                    : 0;

                                const targetTop =
                                    detailsSection.getBoundingClientRect().top +
                                    window.scrollY -
                                    headerHeight -
                                    20;

                                window.scrollTo({
                                    top: Math.max(0, targetTop),
                                    behavior: "smooth"
                                });
                            }
                        } catch (error) {
                            if (error.name === "AbortError") return;

                            panel.innerHTML =
                                '<div class="alert alert-danger">Unable to load cake details.</div>';
                        } finally {
                            if (currentRequest === controller) {
                                currentRequest = null;
                            }
                        }
                    });
                });



            function initializePriceCalculation() {

                const totalElement = panel.querySelector("#totalPrice");
                if (!totalElement) return;

                const basePrice =  parseFloat(totalElement.dataset.basePrice) || 0;

                const dropdowns = panel.querySelectorAll(".cake-option");

                function updateTotal() {
                    let total = basePrice;

                    dropdowns.forEach(dropdown => {
                        const selectedOption = 
                        dropdown.options[dropdown.selectedIndex];
                        if (selectedOption && selectedOption.value){
                            total += parseFloat(selectedOption.dataset.price) || 0;
                        }
                    });
                    totalElement.textContent = "RM " + total.toFixed(2);
                }

                dropdowns.forEach(dropdown => {
                    dropdown.addEventListener("change", updateTotal);
                });

                updateTotal();
            }

        });
    </script>
}             