                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">

                        <!-- Tier Name -->
                        <div class="mb-3">
                            <label class="form-label">
                                Tier Name
                            </label>

                            <input type="number"
                                   name="TierName"
                                   value="@tier.TierName"
                                   class="form-control"
                                   min="1"
                                   step="1"
                                   required
                                   placeholder="Enter tier number" />
                        </div>

                        <!-- Additional Price -->
                        <div class="mb-3">
                            <label class="form-label">
                                Additional Price (RM)
                            </label>

                            <input type="number"
                                   name="AdditionalPrice"
                                   value="@tier.AdditionalPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   required />
                        </div>

                        <!-- Availability -->
                        <div class="form-check">

                            <input type="checkbox"
                                   name="IsAvailable"
                                   value="true"
                                   class="form-check-input"
                                   id="tierAvailable-@tier.TierId"
                                   checked="@tier.IsAvailable" />

                            <input type="hidden"
                                   name="IsAvailable"
                                   value="false" />

                            <label class="form-check-label"
                                   for="tierAvailable-@tier.TierId">
                                Available
                            </label>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
}


<!-- DELETE TIER MODALS-->
@foreach (var tier in Model.CakeTiers)
{
    <div class="modal fade"
		 id="deleteTierModal-@tier.TierId">
         <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete Cake Tier</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the tier "<strong>@tier.TierName</strong>"?</p>
                </div>
                <div class="modal-footer">
                    <form asp-controller="CakeOptions" asp-action="DeleteTier" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@tier.TierId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
	</div>
 }

<!-- ======================================== -->
<!-- TAB SELECTION SCRIPT -->
<!-- ======================================== -->
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const params = new URLSearchParams(window.location.search);
            const selectedTab = params.get("tab");

            // Keep Flavours tab open after Add/Edit
            if (selectedTab === "flavours" || selectedTab === "tiers") {

                // Find the corresponding tab button
                const tabButton = document.getElementById(selectedTab + "-tab");

                if (tabButton) {
                    // Activate the selected Bootstrap tab
                    bootstrap.Tab.getOrCreateInstance(tabButton).show();
                }
            }

        });
    </script>
}
