@model CakeStudio.Models.Cake
@{
	ViewData["Title"] = "Create Cake";

}

<h1>Create Cake</h1>

<form asp-controller="Cake"
	  asp-action="Create"
	  method="post"
	  enctype="multipart/form-data">

	<div asp-validation-summary="ModelOnly"
		 class="text-danger mb-3"></div> 
	
	 <div class="mb-3">
		 <label asp-for="CakeName" class="form-label"></label>
		<input asp-for="CakeName" class="form-control" />
		<span asp-validation-for="CakeName" class="text-danger"></span>
	 </div>

	 <div class="mb-3">
			<label asp-for="Description" class="form-label"> </label>
			<textarea asp-for="Description" class="form-control"></textarea>
			<span asp-validation-for="Description"class=" text-danger"></span>
	</div>

	<div class="mb-3">
		<label for="flavourId" class="form-label">Cake Flavour</label>

		<select id="flavourId"
				name="flavourId"
				class="form-select"
				asp-items="ViewBag.Flavours">
			<option value="">-- Select flavour --</option>
		</select>

		@Html.ValidationMessage(
		"flavourId",
				null,
				new { @class = "text-danger" })
	</div>

	<div class="mb-3">
		<label asp-for="BasePrice" class="form-label"> </label>
		<input asp-for="BasePrice" class="form-control" />
		<span asp-validation-for="BasePrice"class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label for="imageFile" class="form-label">Cake Image</label>

		<input type="file"
			   id="imageFile"
			   name="imageFile"
			   class="form-control"
			   accept="image/jpeg,image/png" />
		@Html.ValidationMessage(
				"imageFile",
				null,
				new { @class = "text-danger" })

	</div>

	<div class="form-check mb-3">
		<input asp-for="IsAvailable" class="form-check-input" />
		<label asp-for="IsAvailable" class="form-check-label"> </label>
</div>

<button type= "submit" class="btn btn-primary">
	Create	
</button>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}