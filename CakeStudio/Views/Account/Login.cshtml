@using CakeStudio.ViewModels
@model LoginViewModel

@{
    ViewData["Title"] = "Login";
    ViewData["FullWidthPage"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
}

<div class="login-page">

    <div class="login-image-panel">
        <div class="login-brand">CakeStudio</div>

        <div class="login-intro">
            <h1>Freshly baked,<br />made for you.</h1>
            <p>
                Explore our signature cakes and keep track
                of your orders in one place.
            </p>
        </div>

        <p class="login-caption">
            Baked with care, delivered with a smile.
        </p>
    </div>

    <div class="login-form-panel">
        <div class="login-form-content">
            <h2>Welcome back</h2>
            <p class="login-subtitle">
                Log in to explore cakes and view your orders.
            </p>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show"
                         role="alert">

                        @TempData["SuccessMessage"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"
                                aria-label="Close">
                        </button>
                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="login-input">
                        <i class="bi bi-envelope" aria-hidden="true"></i>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter your email" 
                               autocomplete="username"/>
                        </div>
                        <span asp-validation-for="Email"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="login-input">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder="Enter your password" 
                               autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn login-submit w-100">
                        Login
                    </button>

                </form>

               

                <!-- Customer Registration -->
                <div class="text-center mt-3">
                    <span class="text-muted">Don't have an account?</span>

                    <a asp-controller="Account"
                       asp-action="Register"
                        class="login-register">
                        Register here
                    </a>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}