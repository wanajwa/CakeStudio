<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CakeStudio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CakeStudio.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <div class="d-flex min-vh-100">

        <!-- sidebar-->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar bg-white border-end d-flex flex-column">

                <!-- Logo -->
                <div class="sidebar-logo text-center">
                    <h4 class="fw-bold mb-0">
                        CakeStudio
                    </h4>
                </div>

                <!-- Navigation at top -->
                <nav class="nav flex-column px-3">

                    <a class="nav-link sidebar-link @(currentController == "Home" ? "active" : "")"
                    asp-controller="Home"
                    asp-action="Index">
                        <i class="bi bi-grid me-3"></i>
                        Dashboard
                    </a>

                    <a class="nav-link sidebar-link @(currentController == "Cake" ? "active" : "")"
                    asp-controller="Cake"
                    asp-action="Index">
                        <i class="bi bi-cake2 me-3"></i>
                        Cakes
                    </a>
                    <a class="nav-link sidebar-link @(currentController == "CakeOptions" ? "active" : "")"
                       asp-controller="CakeOptions"
                       asp-action="Index">

                        <i class="bi bi-sliders me-3"></i>
                        Cake Options

                    </a>

                </nav>

                <!-- Logout at bottom -->

                
                    <div class="mt-auto px-3 pb-4">

                        <form asp-controller="Account"
                        asp-action="Logout"
                        method="post">

                            <button type="submit"
                            class="nav-link sidebar-link border-0 w-100 text-start bg-transparent">

                                <i class="bi bi-box-arrow-right me-3"></i>
                                Logout

                            </button>

                        </form>

                    </div>


            </aside>
        }
        <main role="main" class="main-content flex-grow-1">

            <div class="container-fluid p-5">

                @RenderBody()

            </div>

        </main>

    </div>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
