<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CakeStudio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CakeStudio.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <div class="d-flex min-vh-100">

        <!-- sidebar-->
        @if (User.Identity?.IsAuthenticated == true)
        {
            <aside class="sidebar bg-white border-end d-none d-lg-flex flex-column">

                <!-- Logo -->
                <div class="sidebar-logo text-center">
                    <h4 class="fw-bold mb-0">
                        CakeStudio
                    </h4>
                </div>

                <!-- Navigation at top -->
                <nav class="nav flex-column px-3">

                    @if (User.IsInRole("Baker"))
                    {
                        <!-- Baker Dashboard -->
                        <a class="nav-link sidebar-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home"
                           asp-action="Index">
                            <i class="bi bi-grid me-3"></i>
                            Dashboard
                        </a>

                        <!-- Manage Cakes -->
                        <a class="nav-link sidebar-link @(currentController == "Cake" ? "active" : "")"
                           asp-controller="Cake"
                           asp-action="Index">
                            <i class="bi bi-cake2 me-3"></i>
                            Cakes
                        </a>

                        <!-- Manage Cake Options -->
                        <a class="nav-link sidebar-link @(currentController == "CakeOptions" ? "active" : "")"
                           asp-controller="CakeOptions"
                           asp-action="Index">
                            <i class="bi bi-sliders me-3"></i>
                            Cake Options
                        </a>
                    }

                    else if (User.IsInRole("Customer"))
                {
                <!-- Customer Home -->
                <a class="nav-link sidebar-link @(currentController == "Home" ? "active" : "")"
                   asp-controller="CustomerCake"
                   asp-action="Index">
                    <i class="bi bi-house me-3"></i>
                    Home
                </a>
                }

                </nav>


                <!-- Logout at bottom -->

                
                    <div class="mt-auto px-3 pb-4">

                        <form asp-controller="Account"
                        asp-action="Logout"
                        method="post">

                            <button type="submit"
                            class="nav-link sidebar-link border-0 w-100 text-start bg-transparent">

                                <i class="bi bi-box-arrow-right me-3"></i>
                                Logout

                            </button>

                        </form>

                    </div>


            </aside>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="offcanvas offcanvas-start"
                 tabindex="-1"
                 id="mobileSidebar"
                 aria-labelledby="mobileSidebarLabel">

                <div class="offcanvas-header">
                    <h5 class="offcanvas-title fw-bold" id="mobileSidebarLabel">
                        CakeStudio
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="offcanvas"
                            aria-label="Close"></button>
                </div>

                <div class="offcanvas-body d-flex flex-column">
                    <nav class="nav flex-column">

                        @if (User.IsInRole("Baker"))
                        {
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-grid me-3"></i> Dashboard
                            </a>

                            <a class="nav-link"
                               asp-controller="Cake"
                               asp-action="Index">
                                <i class="bi bi-cake2 me-3"></i> Cakes
                            </a>

                            <a class="nav-link"
                               asp-controller="CakeOptions"
                               asp-action="Index">
                                <i class="bi bi-sliders me-3"></i> Cake Options
                            </a>
                        }
                        else if (User.IsInRole("Customer"))
                        {
                            <a class="nav-link"
                               asp-controller="CustomerCake"
                               asp-action="Index">
                                <i class="bi bi-house me-3"></i> Home
                            </a>
                        }

                    </nav>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="mt-auto">

                        <button type="submit"
                                class="nav-link text-start w-100 border-0 bg-transparent">
                            <i class="bi bi-box-arrow-right me-3"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        }
        <main role="main" class="main-content flex-grow-1">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-lg-none bg-white border-bottom p-3 d-flex align-items-center">
                    <button class="btn btn-outline-secondary"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mobileSidebar"
                            aria-controls="mobileSidebar"
                            aria-label="Open navigation">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <span class="fw-bold ms-3">CakeStudio</span>
                </div>
            }

            <div class="container-fluid p-3 p-md-4 p-lg-5">

                @RenderBody()

            </div>

        </main>

    </div>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
