@using CakeStudio.Constant
@model List<CakeStudio.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";

    var sourceOrders = Model ?? new List<CakeStudio.Models.Order>();

    // Summary cards always count all orders.
    var totalOrders = sourceOrders.Count;
    var preparingOrders = sourceOrders.Count(
        o => o.OrderStatus == OrderStatus.Preparing);
    var readyOrders = sourceOrders.Count(
        o => o.OrderStatus == OrderStatus.Ready);
    var completedOrders = sourceOrders.Count(
        o => o.OrderStatus == OrderStatus.Completed);

    string sort = Context.Request.Query["sort"].ToString();

    var validChoices = new[]
    {
        "", "nearest", "pending", "preparing", "ready", "completed", "rejected", "newest"
    };

    if (!validChoices.Contains(sort))
    {
        sort = "";
    }

    // Choose which orders to display.
    var filteredOrders = sort switch
    {
        "pending" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Pending),

        "preparing" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Preparing),

        "ready" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Ready),

        "completed" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Completed),

        "rejected" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Rejected),

        "nearest" => sourceOrders.Where(
            o => o.OrderStatus == OrderStatus.Pending ||
                 o.OrderStatus == OrderStatus.Preparing ||
                 o.OrderStatus == OrderStatus.Ready),

        // Default and "newest": include all orders.
        _ => sourceOrders.AsEnumerable()
    };


    var sortedOrders =
        sort == "" || sort == "completed" || sort == "rejected" || sort == "newest"
        ? filteredOrders.OrderByDescending(o => o.CreatedAt)
        : filteredOrders.OrderBy(o => o.RequiredDate ?? DateTime.MaxValue);

    var orders = sortedOrders
        .ThenBy(o => o.OrderId)
        .ToList();

    int pageSize = 5;

    int currentPage;

    if (int.TryParse(Context.Request.Query["page"].ToString(), out int page))
    {
        currentPage = page;
    }
    else
    {
        currentPage = 1;
    }

    // Pagination counts the displayed orders.
    int totalPages = Math.Max( 1,(int)Math.Ceiling(orders.Count / (double)pageSize));

    currentPage = Math.Clamp(currentPage, 1, totalPages);

    var pagedOrders = orders
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
}

<div class="container-fluid manage-orders-page mt-4 mb-5">

    <!-- Page Header -->
    <div class="manage-orders-header mb-4">
        <div>
            <h2 class=" mb-0">Manage Orders</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-total">
                    <i class="bi bi-bag"></i>
                </div>
                <div>
                    <p>Total Orders</p>
                    <h3>@totalOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-preparing">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <p>Preparing</p>
                    <h3>@preparingOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-ready">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <p>Ready for Pickup</p>
                    <h3>@readyOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-completed">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <p>Completed</p>
                    <h3>@completedOrders</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Orders Card -->
    <div class="manage-orders-card">

        <div class="orders-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
            <h5 class="mb-0">Customer Orders</h5>

            <form asp-controller="Order"
                  asp-action="Index"
                  method="get"
                  class="d-flex align-items-center gap-2">

                

                <select id="orderSort"
                        name="sort"
                        class="form-select form-select-sm"
                        onchange="this.form.submit()">

                    <option value=""  selected="@(sort == "")">
                        All
                    </option>

                    <option class="text-dark"
                            value="nearest"
                            selected="@(sort == "nearest")">
                        Nearest required date
                    </option>

                    <option class="text-dark"
                            value="pending"
                            selected="@(sort == "pending")">
                        Pending
                    </option>

                    <option class="text-dark"
                            value="preparing"
                            selected="@(sort == "preparing")">
                        Preparing
                    </option>

                    <option class="text-dark"
                            value="ready"
                            selected="@(sort == "ready")">
                        Ready for Pickup
                    </option>

                    <option class="text-dark"
                            value="completed"
                            selected="@(sort == "completed")">
                        Completed
                    </option>

                    <option class="text-dark"
                            value="rejected"
                            selected="@(sort == "rejected")">
                        Rejected
                    </option>

                </select>
            </form>
        </div>

        @if (!orders.Any())
        {
            <div class="orders-empty">
                <i class="bi bi-inbox"></i>
                <h5>No orders found</h5>
                <p>Customer orders will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle orders-table mb-0">

                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Customer</th>
                            <th>Cake</th>
                            <th>Required Date</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int no = (currentPage - 1) * pageSize + 1;
                        }
                        @foreach (var order in pagedOrders)
                        {
                            string statusClass = order.OrderStatus switch
                            {
                                OrderStatus.Pending => "status-pending",
                                OrderStatus.Preparing => "status-preparing",
                                OrderStatus.Ready => "status-ready",
                                OrderStatus.Completed => "status-completed",
                                OrderStatus.Rejected => "status-rejected",
                                _ => "status-default"
                            };

                            string[] nextStatuses = order.OrderStatus switch
                            {
                                OrderStatus.Pending => new[]
                                {
                                        OrderStatus.Preparing,
                                        OrderStatus.Rejected
                                },

                                OrderStatus.Preparing => new[]
                                {
                                        OrderStatus.Ready
                                },

                                OrderStatus.Ready => new[]
                                {
                                        OrderStatus.Completed
                                },
                                _ => Array.Empty<string>()
                            };

                            <tr class="order-row"
                                data-url="@Url.Action("Details", "Order", new { id = order.OrderId })"
                                tabindex="0"
                                aria-label="View order @no details">
                                <td>
                                    <span class="order-id">
                                        @no
                                    </span>
                                </td>

                                <td>
                                    <span class="customer-name">
                                        @(order.Customer?.Name ?? "-")
                                    </span>
                                </td>

                                <td>
                                    <span class="cake-name">
                                        @order.Cake?.CakeName
                                    </span>
                                </td>

                                <td>
                                    @order.RequiredDate?.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <strong class="order-price">
                                        RM @order.TotalPrice.ToString("F2")
                                    </strong>
                                </td>

                                <td>
                                    @if (nextStatuses.Length > 0)
                                    {
                                        <div class="dropdown">
                                            <button type="button"
                                                    class="order-status @statusClass dropdown-toggle status-dropdown-toggle"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    aria-label="Change order @no status">
                                                @(order.OrderStatus == OrderStatus.Ready
                                                    ? "Ready for Pickup"
                                                    : order.OrderStatus)
                                             </button>

                                        <ul class="dropdown-menu dropdown-menu-end">
                                        @foreach (var status in nextStatuses)
                                        {
                                              <li>
                                                    <form asp-controller="Order"
                                                     asp-action="UpdateStatus" method="post">

                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="orderId"
                                                                   value="@order.OrderId" />

                                                            <input type="hidden"
                                                                   name="status"
                                                                   value="@status" />

                                                            <button type="submit"
                                                                    class="dropdown-item">
                                                                @(status == OrderStatus.Ready
                                                                       ? "Ready for Pickup"
                                                                       : status)
                                                            </button>
                                                     </form>
                                             </li>
                                        }
                                        </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="order-status @statusClass">
                                            @order.OrderStatus
                                        </span>
                                    }
                                </td>

                            </tr>
                            no++;
                        
                        }

                    </tbody>
                </table>
            </div>

            <div class="orders-table-footer d-flex justify-content-end align-items-center flex-wrap gap-3">

                @if (totalPages > 1)
                {
                    <nav 
                        aria-label="Order pages">
                        <ul class="pagination orders-pagination mb-0">

                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Order"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-sort="@sort"
                                       aria-label="Previous page">
                                        &lt;
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link" aria-disabled="true">&lt;</span>
                                </li>
                            }

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == currentPage)
                                {
                                    <li class="page-item active">
                                        <span class="page-link" aria-current="page">
                                            @i
                                        </span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-controller="Order"
                                           asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-sort="@sort" >
                                            @i
                                        </a>
                                    </li>
                                }
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Order"
                                       asp-action="Index"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-sort="@sort"
                                       aria-label="Next page">
                                        &gt;
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link" aria-disabled="true">&gt;</span>
                                </li>
                            }

                        </ul>
                    </nav>
                }
            </div>

            
        }

    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".order-row").forEach(function (row) 
        {
            row.addEventListener("click", function (e) 
            {
                const control = e.target.closest(
                    "a, button, input, select, textarea, form"
                );

                if (!control) 
                {
                    window.location.href = row.dataset.url;
                }
            });

            row.addEventListener("keydown", function (e) {
                if (e.target === row && e.key === "Enter") 
                {
                    window.location.href = row.dataset.url;
                }
            });
        });
    </script>
}