@using CakeStudio.Constant
@model List<CakeStudio.Models.Order>

@{
    ViewData["Title"] = "Manage Orders";

    var orders = Model ?? new List<CakeStudio.Models.Order>();

    var totalOrders = orders.Count;

    var preparingOrders = orders.Count(
        o => o.OrderStatus == Constant.OrderStatus.Preparing);

    var readyOrders = orders.Count(
        o => o.OrderStatus == Constant.OrderStatus.Ready);

    var completedOrders = orders.Count(
        o => o.OrderStatus == Constant.OrderStatus.Completed);
}

<div class="container-fluid manage-orders-page mt-4 mb-5">

    <!-- Page Header -->
    <div class="manage-orders-header">
        <div>
            <h2>Manage Orders</h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-total">
                    <i class="bi bi-bag"></i>
                </div>
                <div>
                    <p>Total Orders</p>
                    <h3>@totalOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-preparing">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <p>Preparing</p>
                    <h3>@preparingOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-ready">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <p>Ready for Pickup</p>
                    <h3>@readyOrders</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="order-summary-card">
                <div class="summary-icon icon-completed">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <p>Completed</p>
                    <h3>@completedOrders</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- Orders Card -->
    <div class="manage-orders-card">

        <div class="orders-card-header">
            <div>
                <h5>Customer Orders</h5>

            </div>
        </div>

        @if (!orders.Any())
        {
            <div class="orders-empty">
                <i class="bi bi-inbox"></i>
                <h5>No orders found</h5>
                <p>Customer orders will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle orders-table mb-0">

                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Cake</th>
                            <th>Required Date</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in orders)
                        {
                            string statusClass = order.OrderStatus switch
                            {
                                Constant.OrderStatus.Pending => "status-pending",
                                Constant.OrderStatus.Preparing => "status-preparing",
                                Constant.OrderStatus.Ready => "status-ready",
                                Constant.OrderStatus.Completed => "status-completed",
                                Constant.OrderStatus.Rejected => "status-rejected",
                                _ => "status-default"
                            };

                            string[] nextStatuses = order.OrderStatus switch
                            {
                                Constant.OrderStatus.Pending => new[]
                                {
                                        Constant.OrderStatus.Preparing,
                                        Constant.OrderStatus.Rejected
                                },

                                Constant.OrderStatus.Preparing => new[]
                                {
                                        Constant.OrderStatus.Ready
                                },

                                Constant.OrderStatus.Ready => new[]
                                {
                                        Constant.OrderStatus.Completed
                                },
                                _ => Array.Empty<string>()
                            };

                            <tr>

                                <td>
                                    <span class="order-id">
                                        #@order.OrderId
                                    </span>
                                </td>

                                <td>
                                    <span class="customer-name">
                                        @(order.Customer?.Name ?? "-")
                                    </span>
                                </td>

                                <td>
                                    @(order.Cake?.CakeName ?? "-")
                                </td>

                                <td>
                                    @order.RequiredDate?.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <strong class="order-price">
                                        RM @order.TotalPrice.ToString("F2")
                                    </strong>
                                </td>

                                <td>
                                    <span class="order-status @statusClass">
                                        @(order.OrderStatus == Constant.OrderStatus.Ready
                                                                        ? "Ready for Pickup"
                                                                        : order.OrderStatus)
                            </span>
                        </td>

                                <td>
                                    <div class="order-actions">

                                        <a asp-controller="Order"
                                           asp-action="Details"
                                           asp-route-id="@order.OrderId"
                                           class="order-details-btn">
                                            Details
                                        </a>

                                @if (nextStatuses.Length > 0)
                                        {
                                            <form asp-controller="Order"
                                                  asp-action="UpdateStatus"
                                                  method="post"
                                                  class="order-update-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="orderId"
                                                       value="@order.OrderId" />

                                                <select name="status"
                                                        class="form-select form-select-sm"
                                                        aria-label="Update order #@order.OrderId status"
                                                        required>

                                                    <option value="">
                                                        Update Status
                                                    </option>

                                                    @foreach (var status in nextStatuses)
                                                    {
                                                        <option value="@status">
                                                            @(status == Constant.OrderStatus.Ready
                                                                                                        ? "Ready for Pickup"
                                                                                                        : status)
                                        </option>
                                                                                }

                                                </select>

                                                <button type="submit"
                                                        class="order-update-btn"
                                                        title="Save status"
                                                        aria-label="Save order #@order.OrderId status">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            <div class="orders-table-footer">
                Total: @orders.Count orders
            </div>

            
        }

    </div>
</div>
