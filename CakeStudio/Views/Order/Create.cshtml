@model CakeStudio.ViewModels.OrderViewModel
@using CakeStudio.Models
@using CakeStudio.Constant
@using System.Globalization

@{
    ViewData["Title"] = "Checkout";
	decimal deliveryFee = Model.CollectionMethod == CollectionMethod.Delivery
    ? DeliveryRate.FixedFee
    : 0m;
}

<div class="container mt-4 mb-5">
    <div class="mb-3">
    </div>
    <h2 class="mb-4">Checkout</h2>

    <div class="row g-4">

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form id="orderCheckoutForm"
                        asp-controller="Order"
                          asp-action="Checkout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <h5>Order Information</h5>

                        <div class="mb-3">
                            <label asp-for="RequiredDate"
                                   class="form-label">
                                Required Date
                            </label>

                            <input asp-for="RequiredDate"
                                   type="date"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />

                            <span asp-validation-for="RequiredDate"
                                  class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label asp-for="RequiredTime"
                                   class="form-label">
                                Pickup / Delivery Time
                            </label>

                            <input asp-for="RequiredTime"
                                   type="time"
                                   step="1800"
                                   class="form-control" />

                            <span asp-validation-for="RequiredTime"
                                  class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label asp-for="CollectionMethod"
                                   class="form-label">
                                Collection Method
                            </label>

                            <select asp-for="CollectionMethod"
                                    class="form-select"
                                    id="collectionMethod">

                                <option value="">
                                    Select Method
                                </option>

                                <option value="Pickup">
                                    Pickup
                                </option>

                                <option value="Delivery">
                                    Delivery
                                </option>
                            </select>

                            <span asp-validation-for="CollectionMethod"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3"
                             id="deliverySection"
                             style="display:none;">

                            <label asp-for="DeliveryAddress"
                                   class="form-label">
                                Delivery Address
                            </label>

                            <textarea asp-for="DeliveryAddress"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="DeliveryAddress"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn order-now-btn">
                                Proceed to Payment
                            </button>

                    
                        </div>

                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Order Summary</h5>
                    <hr />

                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between gap-3">
                                <strong>@item.CakeName</strong>

                                <strong class="cake-price text-nowrap">
                                    RM @item.Subtotal.ToString("N2")
                                </strong>
                            </div>

                            <div class="text-muted small mt-2">
                                <div>Base price: RM @item.BasePrice.ToString("N2")</div>
                                <div>
                                    Size: @item.SizeName
                                    @(item.SizePrice == 0m
                                        ? "(Included)"
                                        : $"(+RM {item.SizePrice:N2})")
                                </div>

                                <div>
                                    Flavour: @item.FlavourName
                                    @(item.FlavourPrice == 0m
                                        ? "(Included)"
                                        : $"(+RM {item.FlavourPrice:N2})")
                                </div>

                                <div>
                                    Tier: @item.TierName
                                    @(item.TierPrice == 0m
                                        ? "(Included)"
                                        : $"(+RM {item.TierPrice:N2})")
                                </div>
                                <div>
                                    Quantity: @item.Quantity ×
                                    RM @item.UnitPrice.ToString("N2")
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.MessageOnCakes))
                            {
                                <p class="small mt-2 mb-0">
                                    Message: @item.MessageOnCakes
                                </p>
                            }
                        </div>

                        <hr />
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total quantity</span>
                        <strong>@Model.Cart.TotalQuantity</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Cake Subtotal</span>
                        <span>RM @Model.Cart.TotalPrice.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Delivery Fee</span>
                        <span id="checkoutDeliveryFee">
                            RM @deliveryFee.ToString("F2")
                        </span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <strong>Total Price</strong>
                        <strong class="cake-price" id="checkoutTotal">
                            RM @((Model.Cart.TotalPrice + deliveryFee).ToString("F2"))
                        </strong>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        function toggleDelivery() {
            const method = document.getElementById("collectionMethod").value;

            const section = document.getElementById("deliverySection");

            const address = document.getElementById("DeliveryAddress");

            const isDelivery = method === "Delivery";

            section.style.display = isDelivery ? "block" : "none";

            address.required = isDelivery;

            const subtotal =
            @Model.Cart.TotalPrice.ToString(CultureInfo.InvariantCulture);

            const deliveryFee = isDelivery
                ? @DeliveryRate.FixedFee.ToString(CultureInfo.InvariantCulture)
                : 0;

            document.getElementById("checkoutDeliveryFee").textContent = "RM " + deliveryFee.toFixed(2);

            document.getElementById("checkoutTotal").textContent = "RM " + (subtotal + deliveryFee).toFixed(2);
            }

            document.getElementById("collectionMethod")
                .addEventListener("change", toggleDelivery);
        toggleDelivery();
    </script>
}
