@using CakeStudio.Constant
@model CakeStudio.ViewModels.OrderListViewModel

@{
    ViewData["Title"] = "My Orders";

    int pageSize = Model.PageSize;
    int currentPage = Model.CurrentPage;
    int totalPages = Model.TotalPages;
    var pagedOrders = Model.Orders;
}

<div class="container mt-4">

    <h2 class="mb-4">My Orders</h2>

    @if (!Model.Orders.Any())
    {
        <div class="alert alert-info">
            You haven't placed any orders yet.
        </div>

        <a asp-controller="CustomerCake"
           asp-action="Index"
           class="btn btn-primary">
            Browse Cakes
        </a>
    }
    else
    {
        <div class="card my-orders-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Order Date</th>
                        <th>Required Date</th>
                        <th>Total Price</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < pagedOrders.Count; i++)
                    {
                        var order = pagedOrders[i];

                            <tr class="order-row"
                                data-url="@Url.Action("Details", "Order", new { id = order.OrderId })"
                                tabindex="0"
                                aria-label="View order @((currentPage - 1) * pageSize + i + 1) details"
                                onclick="window.location.href = this.dataset.url"
                                onkeydown="if (event.key === 'Enter') { window.location.href = this.dataset.url; }">
                            <td>@((currentPage - 1) * pageSize + i + 1)</td>
                            <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @(order.RequiredDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </td>
                            <td>RM @order.TotalPrice.ToString("N2")</td>

                            <td>
                                @{
                                    string statusClass = order.OrderStatus switch
                                    {
                                            OrderStatus.Pending => "status-pending",
                                            OrderStatus.Preparing => "status-preparing",
                                            OrderStatus.Ready => "status-ready",
                                            OrderStatus.Completed => "status-completed",
                                            OrderStatus.Rejected => "status-rejected",
                                            _ => "status-default"
                                    };
                                }

                                <span class="order-status @statusClass">
                                    @order.OrderStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
            <div class="orders-table-footer d-flex justify-content-end align-items-center flex-wrap gap-3">

                @if (totalPages > 1)
                {
                    <nav aria-label="My order pages">
                        <ul class="pagination orders-pagination mb-0">

                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Order"
                                       asp-action="MyOrders"
                                       asp-route-page="@(currentPage - 1)"
                                       aria-label="Previous page">
                                        &lt;
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link" aria-disabled="true">
                                        &lt;
                                    </span>
                                </li>
                            }

                            @for (int pageNo = 1; pageNo <= totalPages; pageNo++)
                            {
                                if (pageNo == currentPage)
                                {
                                    <li class="page-item active">
                                        <span class="page-link" aria-current="page">
                                            @pageNo
                                        </span>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           asp-controller="Order"
                                           asp-action="MyOrders"
                                           asp-route-page="@pageNo">
                                            @pageNo
                                        </a>
                                    </li>
                                }
                            }

                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-controller="Order"
                                       asp-action="MyOrders"
                                       asp-route-page="@(currentPage + 1)"
                                       aria-label="Next page">
                                        &gt;
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link" aria-disabled="true">
                                        &gt;
                                    </span>
                                </li>
                            }

                        </ul>
                    </nav>
                }
            </div>
    </div>
    }
</div>
