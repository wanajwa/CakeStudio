@using CakeStudio.Constant
@model List<CakeStudio.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">

    <h2 class="mb-4">My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't placed any orders yet.
        </div>

        <a asp-controller="CustomerCake"
           asp-action="Index"
           class="btn btn-primary">
            Browse Cakes
        </a>
    }
    else
    {
        <div class="card my-orders-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Order Date</th>
                        <th>Required Date</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var order = Model[i];

                        <tr>
                            <td>@(i + 1)</td>
                            <td>@order.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @(order.RequiredDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </td>
                            <td>RM @order.TotalPrice.ToString("N2")</td>

                            <td>
                                @{
                                    string statusClass = order.OrderStatus switch
                                    {
                                            Constant.OrderStatus.Pending => "status-pending",
                                            Constant.OrderStatus.Preparing => "status-preparing",
                                            Constant.OrderStatus.Ready => "status-ready",
                                            Constant.OrderStatus.Completed => "status-completed",
                                            Constant.OrderStatus.Rejected => "status-rejected",
                                            _ => "status-default"
                                    };
                                }

                                <span class="order-status @statusClass">
                                    @order.OrderStatus
                                </span>
                            </td>

                            <td>
                                <a asp-controller="Order"
                                   asp-action="Details"
                                   asp-route-id="@order.OrderId"
                                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    }
</div>
