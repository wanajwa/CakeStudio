@model CakeStudio.ViewModels.PaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h3>Complete Payment</h3>

        <p class="text-muted">
            Enter your test card details to complete payment.
        </p>
    </div>

    <div class="row g-4">

        <!-- Left: Card Details -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="Order"
                          asp-action="Payment"
                          method="post"
                          id="paymentForm">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                         </div>
                
                        <!-- Card Details -->
                        <h5 class="mb-3">Card Details</h5>

           
                        <!-- Card Number -->
                        <div class="mb-3">
                            <label asp-for="CardNumber" class="form-label">
                                Card Number
                            </label>

                            <input asp-for="CardNumber"
                                   class="form-control rounded-3"
                                   placeholder="0000 0000 0000 0000"
                                   maxlength="19"
                                   inputmode="numeric"
                                   autocomplete="off" />

                            <span asp-validation-for="CardNumber"
                                  class="text-danger"></span>
                        </div>

                        <div class="row mb-4">

                            <!-- Expiry Date -->
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="ExpiryDate" class="form-label">
                                    Expiry Date
                                </label>

                                <input asp-for="ExpiryDate"
                                       class="form-control rounded-3"
                                       placeholder="MM/YY"
                                       maxlength="5"
                                       autocomplete="off" />

                                <span asp-validation-for="ExpiryDate"
                                      class="text-danger"></span>
                            </div>

                            <!-- Security Code -->
                            <div class="col-md-6">
                                <label asp-for="SecurityCode" class="form-label">
                                    Security Code (CVV)
                                </label>

                                <input asp-for="SecurityCode"
                                       type="password"
                                       class="form-control rounded-3"
                                       placeholder="000"
                                       maxlength="3"
                                       inputmode="numeric"
                                       autocomplete="off" />

                                <span asp-validation-for="SecurityCode"
                                      class="text-danger"></span>
                            </div>

                        </div>

                        <button type="submit"
                                id="payButton"
                                class="btn order-now-btn w-100">
                            <i class="bi bi-credit-card me-2"></i>
                            Pay RM @Model.Amount.ToString("F2")
                        </button>

                    </form>
                </div>
            </div>
        </div>

        <!-- Right: Order Summary -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-body p-4">

                    <h5 class="mb-3">Order Summary</h5>
                    <hr />

                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between gap-3">
                                <strong>@item.CakeName</strong>

                                <strong class="cake-price text-nowrap">
                                    RM @item.Subtotal.ToString("N2")
                                </strong>
                            </div>

                            <div class="text-muted small mt-2">
                                <div>Size: @item.SizeName</div>
                                <div>Flavour: @item.FlavourName</div>
                                <div>Tier: @item.TierName</div>
                                <div>
                                    Quantity: @item.Quantity ×
                                    RM @item.UnitPrice.ToString("N2")
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.MessageOnCakes))
                            {
                                <p class="small mt-2 mb-0">
                                    Message: @item.MessageOnCakes
                                </p>
                            }
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>Total quantity</span>
                        <strong>@Model.Cart.TotalQuantity</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-2">
                        <span>Cake Subtotal</span>
                        <span>RM @Model.Cart.TotalPrice.ToString("F2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Delivery Fee</span>
                        <span>RM @Model.DeliveryFee.ToString("F2")</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fw-bold mb-3">
                        <span>Total Price</span>
                        <span class="cake-price">
                            RM @Model.Amount.ToString("F2")
                        </span>
                    </div>

                    <hr />

                    <h6 class="mb-3">Order Information</h6>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Required Date</span>
                        <span>@Model.RequiredDate?.ToString("dd/MM/yyyy")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Required Time</span>
                        <span>@Model.RequiredTime?.ToString(@"hh\:mm")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Collection</span>
                        <span>@Model.CollectionMethod</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span>Payment Method</span>
                        <strong>Card</strong>
                    </div>

                </div>
            </div>
        </div>

    </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            document.addEventListener("DOMContentLoaded", function () {

                const paymentForm = document.getElementById("paymentForm");
                const payButton = document.getElementById("payButton");
                const cardNumberInput = document.getElementById("CardNumber");

                if (cardNumberInput) {
                    cardNumberInput.addEventListener("input", function () {

                        let value = this.value.replace(/\D/g, "").substring(0, 16); //rm non digit

                        this.value = value.replace(/(\d{4})(?=\d)/g, "$1 "); //letak space after 4 digit
                    });
                }
                const expiryInput = document.getElementById("ExpiryDate");

                if (expiryInput) {
                    expiryInput.addEventListener("input", function () {
                        let value = this.value.replace(/\D/g, "").substring(0, 4); //rm non d

                        if (value.length > 2) {
                            value = value.substring(0, 2) + "/" + value.substring(2);
                        }

                        this.value = value;
                    });
                }

                if (!paymentForm || !payButton) return;

                let isSubmitting = false;

                paymentForm.addEventListener("submit", function (event) {

                    if (isSubmitting) {
                        event.preventDefault();
                        return;
                    }

                    if (!paymentForm.checkValidity()) {
                        return;
                    }

                    if (window.jQuery &&
                        $.validator &&
                        !$(paymentForm).valid()) {
                        return;
                    }

                    isSubmitting = true;

                    payButton.disabled = true;
                    payButton.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"
                              aria-hidden="true"></span>
                        Processing Payment...
                    `;
                });

            });
        </script>
    }
