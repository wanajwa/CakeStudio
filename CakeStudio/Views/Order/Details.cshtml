@using CakeStudio.Constant
@model CakeStudio.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

    <div class="order-details-footer">

        @if (User.IsInRole("Baker"))
        {
            <a asp-action="Index"
               class="order-back-btn">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Orders
            </a>
        }

    </div>

    @{
        string statusClass = Model.Order.OrderStatus switch
        {
            OrderStatus.PendingPayment => "status-awaiting-payment",
            OrderStatus.OrderPlaced => "status-pending",
            OrderStatus.Preparing => "status-preparing",
            OrderStatus.Ready => "status-ready",
            OrderStatus.Completed => "status-completed",
            OrderStatus.Rejected => "status-rejected",
            _ => "status-default"
        };
    }

    <div class="order-details-header">

        <div>
            <h3 class="mb-2">
                Order Details
            </h3>

            <p class="text-muted mb-0">
                Placed on @Model.Order.CreatedAt.ToString("dd MMM yyyy")
            </p>
        </div>

        <div class="d-flex align-items-center flex-wrap gap-3">

            <span class="order-status @statusClass">
                @(Model.Order.OrderStatus switch
                {
                    OrderStatus.PendingPayment => "Pending Payment",
                    OrderStatus.OrderPlaced => "Order Placed",
                    _ => Model.Order.OrderStatus
                })
            </span>

            @if (User.IsInRole("Customer") &&
                        Model.Order.OrderStatus == OrderStatus.PendingPayment && Model.Payment?.PaymentStatus == PaymentStatus.Pending)
            {
                <form asp-controller="Order" asp-action="PayNow" method="post">
                    <input type="hidden" name="id" value="@Model.Order.OrderId" />
                    <button type="submit" class="btn order-now-btn">Pay Now</button>

                </form>

                <form id="cancelOrderForm"
                      asp-controller="Order"
                      asp-action="CancelUnpaidOrder"
                      method="post">
                    <input type="hidden" name="id" value="@Model.Order.OrderId" />

                    <button type="button"
                            class="btn btn-danger cancel-order-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#cancelOrderModal">
                        Cancel Order
                    </button>
                </form>
            }

            @if (User.IsInRole("Customer") &&
                        Model.Order.OrderStatus == OrderStatus.OrderPlaced)
            {
                <a asp-controller="Order"
                   asp-action="Edit"
                   asp-route-id="@Model.Order.OrderId"
                   class="btn order-now-btn">
                    <i class="bi bi-pencil me-2"></i>
                    Edit Order
                </a>
            }

        </div>

    </div>

    <div class="card order-details-card">
        <div class="card-body p-4">
            @if (User.IsInRole("Baker"))
            {
                <div class="order-info-section mb-4">

                    <h5 class="order-section-title">
                        <i class="bi bi-person me-2"></i>
                        Customer Information
                    </h5>

                    <dl class="row order-info-list">

                        <dt class="col-sm-4">Customer Name</dt>
                        <dd class="col-sm-8">
                            @Model.CustomerName
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @Model.CustomerEmail
                        </dd>

                        <dt class="col-sm-4">Phone Number</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.CustomerPhone)
                                                    ? "-"
                                                    : Model.CustomerPhone)
                                                                      </dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.CustomerAddress)
                                                    ? "-"
                                                    : Model.CustomerAddress)
                    </dd>

                    </dl>

                </div>
                        }

            <div class="order-info-section">

                <h5 class="order-section-title">
                    <i class="bi bi-receipt me-2"></i>
                    Order Information
                </h5>

                <dl class="row order-info-list">

                <dt class="col-sm-4">Order Date</dt>
                <dd class="col-sm-8">
                    @Model.Order.CreatedAt.ToString("dd MMM yyyy")
                </dd>


                <dt class="col-sm-4">Required Date</dt>
                <dd class="col-sm-8">
                    @Model.Order.RequiredDate?.ToString("dd MMM yyyy")
                </dd>

                    <dt class="col-sm-4">Scheduled Time</dt>
                    <dd class="col-sm-8">
                        @Model.Order.RequiredDate?.ToString("hh:mm tt")
                    </dd>

                </dl>
            </div>

            @if (Model.Order.OrderStatus == OrderStatus.Rejected && !string.IsNullOrWhiteSpace(Model.Order.RejectionReason))
            {
                <div class="alert alert-danger">
                    <strong>Reason for rejection</strong>

                    <p class="mb-0" style="white-space: pre-wrap">@Model.Order.RejectionReason</p>
                </div>
            }

            @if (Model.Order.OrderStatus == OrderStatus.Cancelled && !string.IsNullOrWhiteSpace(Model.Order.CancellationReason))
            {
                <div class="alert alert-secondary">
                    <strong>Reason for cancellation</strong>
                    <p class="mb-0">@Model.Order.CancellationReason</p>
                </div>
            }

            <!-- Order Items Section -->
            <div class="order-items-section">

                <h5 class="order-section-title">
                    <i class="bi bi-cake2 me-2"></i>
                    Order Items
                </h5>

                @foreach (var item in Model.OrderItems)
                {
                    <div class="mb-4">
                        <div class="order-item-name d-flex align-items-center gap-2">
                            <img src="@Url.Action("CakeImage", "Order", new
                                 {
                                     id = Model.Order.OrderId,
                                     cakeId = item.CakeId
                                 })"
                                    class="cart-cake-image"
                                    alt=""
                                    loading="lazy"
                                    onerror="this.hidden = true; this.nextElementSibling.classList.remove('d-none');" />

                            <span class="d-none cart-cake-image bg-light text-center align-content-center">
                                <i class="bi bi-cake2" aria-hidden="true"></i>
                                <span class="visually-hidden">No image available</span>
                            </span>

                            <span>@(item.Cake?.CakeName ?? "Unknown Cake")</span>
                        </div>

                        <div class="order-item-options">
                            <div>
                                <span>Flavour</span>
                                <strong>@(item.Flavour?.FlavourName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Size</span>
                                <strong>@(item.Size?.SizeName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Tier</span>
                                <strong>@(item.Tier?.TierName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Quantity</span>
                                <strong>@item.Quantity</strong>
                            </div>
                        </div>

                        <div class="mt-3 text-end">
                            <strong class="cake-price">
                                RM @((item.UnitPrice * item.Quantity).ToString("N2"))
                            </strong>
                        </div>

                        <div class="order-cake-message">
                            <span>Cake Message</span>

                            <p class="mb-0">
                                @(string.IsNullOrWhiteSpace(item.MessageOnCakes)
                                                            ? "-"
                                                            : item.MessageOnCakes)
                        </p>
                    </div>
                </div>
                                }
            </div>

            <!-- Total Price Section -->
            <div class="order-total-section">

                <div>
                    <h5 class="mb-1">Total Price</h5>
                    <small>Final order amount</small>
                </div>

                <h4 class="order-total-amount mb-0">
                    RM @Model.Order.TotalPrice.ToString("F2")
                </h4>

            </div>

            <!-- Payment Information Section -->
            <div class="order-info-section mt-4">

                <h5 class="order-section-title">
                    <i class="bi bi-credit-card me-2"></i>
                    Payment Information
                </h5>

                @if (Model.Payment != null)
                {
                    <dl class="row order-info-list">

                        <dt class="col-sm-4">Payment Method</dt>
                        <dd class="col-sm-8">
                            Debit / Credit Card
                        </dd>

                        <dt class="col-sm-4">Payment Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Payment.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="order-status status-completed">
                                    Paid
                                </span>
                            }
                            else if (Model.Payment.PaymentStatus == PaymentStatus.RefundRequired)
                            {
                                var threeDaysPassed = Model.Order.UpdatedAt is DateTime rejectedAt && DateTime.Now >= rejectedAt.AddDays(3);

                                <span class="order-status status-rejected">
                                    @if (User.IsInRole("Baker"))
                                    {
                                        <text>Refund Required</text>
                                    }
                                    else if (threeDaysPassed)
                                    {
                                        <text>Refunded</text>
                                    }
                                    else
                                    {
                                        <text>Awaiting Refund</text>
                                    }
                                </span>
                            }
                            else if (Model.Payment.PaymentStatus == PaymentStatus.Refunded)
                            {
                                <span class="order-status status-rejected">
                                    Refunded
                                </span>
                            }
                            else
                            {
                                <span class="order-status status-default">
                                    @Model.Payment.PaymentStatus
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4">Payment Date</dt>
                        <dd class="col-sm-8">
                            @(Model.Payment.PaidAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                        </dd>

                        @if (Model.Payment.PaymentStatus == PaymentStatus.Refunded)
                        {
                            <dt class="col-sm-4">Refund Date</dt>
                            <dd class="col-sm-8">
                                @(Model.Payment.RefundedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </dd>
                        }

                    </dl>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No payment information available for this order.
                    </p>
                }

            </div>

            <div class="modal fade"
                 id="cancelOrderModal"
                 tabindex="-1"
                 aria-labelledby="cancelOrderModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4">
                        <div class="modal-header">
                            <h5 class="modal-title" id="cancelOrderModalLabel">
                                Cancel Order
                            </h5>
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                        </div>

                        <div class="modal-body">
                            Are you sure you want to cancel this unpaid order?
                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-outline-secondary rounded-pill px-4"
                                    data-bs-dismiss="modal">
                                Keep Order
                            </button>

                            <button type="submit"
                                    class="btn btn-danger cancel-order-btn rounded-pill px-4"
                                    form="cancelOrderForm">
                                Cancel Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>

          

        </div>
    </div>
</div>
