@using CakeStudio.Constant
@model CakeStudio.ViewModels.OrderDetailsViewModel
@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4 mb-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

    <div class="order-details-footer">

        @if (User.IsInRole("Baker"))
        {
            <a asp-action="Index"
               class="order-back-btn">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Orders
            </a>
        }

    </div>

    @{
        string statusClass = Model.Order.OrderStatus switch
        {
            OrderStatus.Pending => "status-pending",
            OrderStatus.Preparing => "status-preparing",
            OrderStatus.Ready => "status-ready",
            OrderStatus.Completed => "status-completed",
            OrderStatus.Rejected => "status-rejected",
            _ => "status-default"
        };
    }

    <div class="order-details-header">

        <div>
            <h3 class="mb-2">
                Order Details
            </h3>

            <p class="text-muted mb-0">
                Placed on @Model.Order.CreatedAt.ToString("dd MMM yyyy")
            </p>
        </div>

        <div class="d-flex align-items-center flex-wrap gap-3">

            <span class="order-status @statusClass">
                @Model.Order.OrderStatus
            </span>

            @if (User.IsInRole("Customer") &&
                        Model.Order.OrderStatus == OrderStatus.Pending)
            {
                <a asp-controller="Order"
                   asp-action="Edit"
                   asp-route-id="@Model.Order.OrderId"
                   class="btn order-now-btn">
                    <i class="bi bi-pencil me-2"></i>
                    Edit Order
                </a>
            }

        </div>

    </div>

    <div class="card order-details-card">
        <div class="card-body p-4">
            @if (User.IsInRole("Baker"))
            {
                <div class="order-info-section mb-4">

                    <h5 class="order-section-title">
                        <i class="bi bi-person me-2"></i>
                        Customer Information
                    </h5>

                    <dl class="row order-info-list">

                        <dt class="col-sm-4">Customer Name</dt>
                        <dd class="col-sm-8">
                            @Model.CustomerName
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            @Model.CustomerEmail
                        </dd>

                        <dt class="col-sm-4">Phone Number</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.CustomerPhone)
                                                    ? "-"
                                                    : Model.CustomerPhone)
                                                                      </dd>

                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.CustomerAddress)
                                                    ? "-"
                                                    : Model.CustomerAddress)
                    </dd>

                    </dl>

                </div>
                        }

            <div class="order-info-section">

                <h5 class="order-section-title">
                    <i class="bi bi-receipt me-2"></i>
                    Order Information
                </h5>

                <dl class="row order-info-list">

                <dt class="col-sm-4">Order Date</dt>
                <dd class="col-sm-8">
                    @Model.Order.CreatedAt.ToString("dd MMM yyyy")
                </dd>


                <dt class="col-sm-4">Required Date</dt>
                <dd class="col-sm-8">
                    @Model.Order.RequiredDate?.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-4">Pickup / Delivery Time</dt>
                <dd class="col-sm-8">
                    @Model.Order.RequiredDate?.ToString("hh:mm tt")
                </dd>

                <dt class="col-sm-4">Collection Method</dt>
                <dd class="col-sm-8">
                    @Model.Order.CollectionMethod
                </dd>

                @if (Model.Order.CollectionMethod == "Delivery")
                {
                    <dt class="col-sm-4">Delivery Address</dt>
                    <dd class="col-sm-8">
                        @Model.Order.DeliveryAddress
                    </dd>
                }

                </dl>
            </div>

            @if (Model.Order.OrderStatus == OrderStatus.Rejected &&
                        !string.IsNullOrWhiteSpace(Model.Order.RejectionReason))
            {
                <div class="alert alert-danger">
                    <strong>Reason for rejection</strong>

                    <p class="mb-0" style="white-space: pre-wrap">@Model.Order.RejectionReason</p>
                </div>
            }

            <!-- Order Items Section -->
            <div class="order-items-section">

                <h5 class="order-section-title">
                    <i class="bi bi-cake2 me-2"></i>
                    Order Items
                </h5>

                @foreach (var item in Model.OrderItems)
                {
                    <div class="mb-4">
                        <div class="order-item-name">
                            @(item.Cake?.CakeName ?? "Unknown Cake")
                        </div>

                        <div class="order-item-options">
                            <div>
                                <span>Flavour</span>
                                <strong>@(item.Flavour?.FlavourName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Size</span>
                                <strong>@(item.Size?.SizeName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Tier</span>
                                <strong>@(item.Tier?.TierName ?? "-")</strong>
                            </div>

                            <div>
                                <span>Quantity</span>
                                <strong>@item.Quantity</strong>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between flex-wrap gap-2 mt-3">
                            <span>
                                Unit price: RM @item.UnitPrice.ToString("N2")
                            </span>

                            <strong class="cake-price">
                                Subtotal: RM @((item.UnitPrice * item.Quantity).ToString("N2"))
                            </strong>
                        </div>

                        <div class="order-cake-message">
                            <span>Cake Message</span>

                            <p class="mb-0">
                                @(string.IsNullOrWhiteSpace(item.MessageOnCakes)
                                                            ? "-"
                                                            : item.MessageOnCakes)
                        </p>
                    </div>
                </div>
                                }
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span>Cake Subtotal</span>
                <span>
                    RM @((Model.Order.TotalPrice -
                                        Model.Order.DeliveryFee).ToString("F2"))
                </span>
            </div>

            <div class="d-flex justify-content-between mb-3">
                <span>Delivery Fee</span>
                <span>
                    RM @Model.Order.DeliveryFee.ToString("F2")
                </span>
            </div>

            <!-- Total Price Section -->
            <div class="order-total-section">

                <div>
                    <h5 class="mb-1">Total Price</h5>
                    <small>Final order amount</small>
                </div>

                <h4 class="order-total-amount mb-0">
                    RM @Model.Order.TotalPrice.ToString("F2")
                </h4>

            </div>

            <!-- Payment Information Section -->
            <div class="order-info-section mt-4">

                <h5 class="order-section-title">
                    <i class="bi bi-credit-card me-2"></i>
                    Payment Information
                </h5>

                @if (Model.Payment != null)
                {
                    <dl class="row order-info-list">

                        <dt class="col-sm-4">Payment Method</dt>
                        <dd class="col-sm-8">
                            Debit / Credit Card
                        </dd>

                        <dt class="col-sm-4">Payment Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Payment.PaymentStatus == PaymentStatus.Paid)
                            {
                                <span class="order-status status-completed">
                                    Paid
                                </span>
                            }
                            else if (Model.Payment.PaymentStatus == PaymentStatus.Refunded)
                            {
                                <span class="order-status status-rejected">
                                    Refunded
                                </span>
                            }
                            else
                            {
                                <span class="order-status status-default">
                                    @Model.Payment.PaymentStatus
                                </span>
                            }
                        </dd>

                        <dt class="col-sm-4">Amount Paid</dt>
                        <dd class="col-sm-8">
                            RM @Model.Payment.Amount.ToString("F2")
                        </dd>

                        <dt class="col-sm-4">Payment Date</dt>
                        <dd class="col-sm-8">
                            @(Model.Payment.PaidAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                        </dd>

                        @if (Model.Payment.PaymentStatus == PaymentStatus.Refunded)
                        {
                            <dt class="col-sm-4">Refund Date</dt>
                            <dd class="col-sm-8">
                                @(Model.Payment.RefundedAt?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")
                            </dd>
                        }

                    </dl>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No payment information available for this order.
                    </p>
                }

            </div>

          

        </div>
    </div>
</div>
