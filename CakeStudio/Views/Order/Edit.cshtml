@model CakeStudio.ViewModels.OrderViewModel
@using CakeStudio.Constant
@{
    ViewData["Title"] = "Edit Order";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4">Edit Order</h2>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <p class="text-muted">
                        Update your order information before preparation starts.
                    </p>

                    <form asp-controller="Order"
                          asp-action="Edit"
                          method="post">

                        <input asp-for="OrderId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RequiredDate"
                                   class="form-label">
                                Required Date
                            </label>

                            <input asp-for="RequiredDate"
                                   type="date"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   class="form-control" />

                            <span asp-validation-for="RequiredDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RequiredTime" class="form-label">
                                Scheduled Time
                            </label>

                            <input asp-for="RequiredTime"
                                   type="time"
                                   min="@(PickupHours.OpensAt.ToString(@"hh\:mm"))"
                                   max="@(PickupHours.ClosesAt.ToString(@"hh\:mm"))"
                                   step="1800"
                                   class="form-control" />

                            <span asp-validation-for="RequiredTime"
                                  class="text-danger"></span>
                        </div>

                       

                        @for (int i =0; i < Model.OrderItems.Count; i++)
                        {
                            <div class=" mb-4">
                                <input asp-for ="OrderItems[i].OrderItemId" type="hidden" />
                                <label asp-for = "OrderItems[i].MessageOnCakes" class="form-label">
                                    Message for
                                    @(Model.OrderItems[i].Cake?.CakeName ?? "Cake") - Item @(i + 1)
                                </label>
                                <textarea asp-for="OrderItems[i].MessageOnCakes"
                                          class="form-control"
                                          rows="2"
                                          maxlength="500"
                                          placeholder="e.g. Happy Birthday!">
                                </textarea>

                                <span asp-validation-for="OrderItems[i].MessageOnCakes" class="text-danger"></span>

                            </div>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn order-now-btn">
                                Save Changes
                            </button>

                            <a asp-controller="Order"
                               asp-action="Details"
                               asp-route-id="@Model.OrderId"
                               class="btn btn-outline-secondary rounded-pill"
                               style="padding: 11px 24px;">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}